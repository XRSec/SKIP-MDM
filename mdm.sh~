cleanMdm() {
  ## 检查 监管软件概要文件夹
  if [ "$(basename "${MDMPath}")" != "ConfigurationProfiles" ]; then
    msg_err "未找到监管软件概要文件夹, 请联系管理员修复脚本"
  fi

  msg_info "正在清理监管软件概要文件夹"
  msg_over

  ## 获取用户许可
  printf "${INFO}%s" "  " 1>&2
  # shellcheck disable=SC2039
  read -p "请问您是否需要用到 苹果描述文件? (y/n 默认: n): " -n 1 -r -t 10 AppleDescriptions
  msg_over
  msg_info "正在清理"
  msg_over

  ## 清理监管软件概要文件夹
  deleteFile "${MDMPath}/.profilesAreInstalled"
  deleteFile "${MDMPath}/Store"
  deleteFile "${MDMPath}/Settings"
  #  deleteFile "${OSPATH}/var/db/.AppleSetupDone"
  deleteFile "${LibraryPath}/Keychains/apsd.keychain"
  deleteFile "${LibraryPath}/Keychains/System.keychain"
  deleteFile "${LibraryPath}/Preferences/com.apple.wifi.known-networks.plist"

  if [ "${AppleDescriptions}" != "y" ]; then
    touch "${MDMPath}/.profilesAreInstalled"
    touch "${MDMPath}/Store"
    touch "${MDMPath}/Settings"
    chmod -R 444 "${MDMPath}"
  fi

  msg_ok "清理监管软件概要文件完成"
  msg_over
}

# 检查是否存在
findAndDelete() {
  IFSSet
  #   if filename is not empty
  filePath=$1
  maxDepth=$2
  fileName=$3
  if [ -n "${filePath}" ] && [ -n "${fileName}" ] && [ -n "${maxDepth}" ]; then
    for a in $(find -L "${filePath}" -iname "*${fileName}*" -maxdepth "${maxDepth}" -follow 2>&1); do
      msg_info "正在清理 $1"
      msg_over
      deleteFile "$a"
      msg_ok "清理 ${a##*/} 完成"
      msg_over
    done
  else
    msg_err "参数错误: filePath: ${filePath} maxDepth: ${maxDepth} fileName: ${fileName}"
  fi
  IFSRestore
}

