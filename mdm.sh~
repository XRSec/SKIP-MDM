disableSip() {
  msg_info "正在关闭系统完整性保护, 请注意输入提示输入 y 和 密码"
  sleep 2
  msg_over
  sh -c "csrutil disable"
  printf "  "
}

checkSip() {
  if [ "$(csrutil status | grep disabled)" = "" ]; then
    case $OSTYPE in
    "normal")
      msg_err "请先前往恢复模式 关闭系统完整性保护."
      ;;
    "recovery")
      disableSip
      ;;
    *)
      msg_err "未知的系统类型, 请联系管理员修复脚本."
      ;;
    esac
  else
    case $OSTYPE in
    "normal")
      msg_info "系统完整性保护已关闭."
      msg_over
      ;;
    "recovery")
      msg_info "当前系统完整性保护已关闭."
      msg_over
      ;;
    *)
      msg_err "未知的系统类型, 请联系管理员修复脚本."
      ;;
    esac
  fi
}

# 调试开关
